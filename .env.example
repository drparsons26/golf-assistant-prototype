OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GOLFAPI_API_KEY=your_golfapi_api_key_here
GOLFAPI_BASE_URL=https://golfapi.io/api/v2.3
PORT=3000
HOST=0.0.0.0
# Canonical public origin used in emailed sign-in links. Required when accounts
# are enabled outside localhost; never derive production links from Host headers.
PUBLIC_BASE_URL=http://localhost:3000

# Number of trusted reverse-proxy entries at the right edge of X-Forwarded-For.
# Keep 0 for direct/local servers. Render uses 1.
TRUSTED_PROXY_HOPS=0


# Shared access code. When set, /api/voice-agent, /api/transcribe, and the
# GOLFAPI proxy require a matching code from the app's Settings screen.
# Leave blank only for local development on a trusted network.
APP_ACCESS_TOKEN=choose_a_long_random_access_code

# Per-client request ceilings. Window limits cover a rolling 5 minutes.
AI_WINDOW_REQUEST_LIMIT=30
AI_DAILY_REQUEST_LIMIT=400
GOLFAPI_WINDOW_REQUEST_LIMIT=60
GOLFAPI_DAILY_REQUEST_LIMIT=600

# Server-wide daily ceilings across every client. These cap what the whole
# deployment can spend in a day; per-client limits above cap one device.
AI_GLOBAL_DAILY_LIMIT=1500
GOLFAPI_GLOBAL_DAILY_LIMIT=2000
AUTH_WINDOW_REQUEST_LIMIT=12
AUTH_DAILY_REQUEST_LIMIT=60
AUTH_GLOBAL_DAILY_LIMIT=2000


# Kill switch. Set to true to start with the AI and GOLFAPI endpoints paused.
# Scoring, the scorecard, and saved course data keep working while paused.
API_PAUSED=false

# Admin token for GET/POST /api/admin/usage, which reports today's usage and
# pauses or resumes spending without a redeploy. Leave blank to disable.
ADMIN_TOKEN=choose_a_long_random_admin_token

# Accounts and sync. Leave DATABASE_URL blank to run in device-only mode:
# the app works fully, stores everything in the browser, and hides sign-in.
DATABASE_URL=
# Optional PEM certificate for a private database certificate authority. Remote
# certificates are verified by default; localhost connections run without TLS.
DATABASE_CA_CERT=


# Sign-in link email delivery. Without these the link is written to the
# server log instead, which is fine for solo testing.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=Golf Assistant <signin@yourdomain.com>

# Set to true only for local HTTP testing; it drops Secure from the cookie.
COOKIE_INSECURE=false
