OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GOLFAPI_API_KEY=your_golfapi_api_key_here
GOLFAPI_BASE_URL=https://golfapi.io/api/v2.3
PORT=3000
HOST=0.0.0.0

# Shared access code. When set, /api/voice-agent, /api/transcribe, and the
# GOLFAPI proxy require a matching code from the app's Settings screen.
# Leave blank only for local development on a trusted network.
APP_ACCESS_TOKEN=choose_a_long_random_access_code

# Per-client request ceilings. Window limits cover a rolling 5 minutes.
AI_WINDOW_REQUEST_LIMIT=30
AI_DAILY_REQUEST_LIMIT=400
GOLFAPI_WINDOW_REQUEST_LIMIT=60
GOLFAPI_DAILY_REQUEST_LIMIT=600
